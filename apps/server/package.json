{
  "name": "@pi/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./entry": "./dist/main.js"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsx src/main.ts",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest --run"
  },
  "dependencies": {
    "@pi/agent-worker": "workspace:*",
    "@pi/protocol": "workspace:*",
    "express": "^5.2.1",
    "ws": "^8.21.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/express": "^5.0.6",
    "@types/ws": "^8.18.1",
    "tsx": "^4.20.0",
    "tsup": "^8.5.0",
    "typescript": "^5.9.0",
    "vitest": "^4.1.0"
  }
}
