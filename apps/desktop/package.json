{
  "name": "@pi/desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "pnpm --filter @pi/app build && pnpm --filter @pi/server build && pnpm run build:main",
    "build:main": "tsup",
    "typecheck": "tsc --noEmit",
    "preview": "pnpm run build && electron ."
  },
  "dependencies": {
    "@pi/adapter": "workspace:*",
    "@pi/app": "workspace:*",
    "@pi/server": "workspace:*",
    "@pi/shared": "workspace:*",
    "react": "latest",
    "react-dom": "latest"
  },
  "devDependencies": {
    "@types/node": "latest",
    "electron": "42.3.0",
    "tsup": "^8.5.0",
    "typescript": "^5.9.0",
    "vite": "latest"
  }
}
