{
  "name": "streaming-markdown-kit",
  "version": "0.1.0",
  "description": "Experimental streaming Markdown presets and snapshot-derived Codex-style UI for React",
  "type": "module",
  "license": "MIT",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./plugins": {
      "types": "./dist/plugins/index.d.ts",
      "import": "./dist/plugins/index.js"
    },
    "./extensions": {
      "types": "./dist/extensions/index.d.ts",
      "import": "./dist/extensions/index.js"
    },
    "./preset": {
      "types": "./dist/runtime/preset.d.ts",
      "import": "./dist/runtime/preset.js"
    },
    "./renderers": {
      "types": "./dist/renderers/index.d.ts",
      "import": "./dist/renderers/index.js"
    },
    "./styles.css": "./dist/styles/index.css",
    "./code.css": "./dist/styles/code.css",
    "./table": {
      "types": "./dist/table/index.d.ts",
      "import": "./dist/table/index.js"
    },
    "./table.css": "./dist/styles/table.css",
    "./math": {
      "types": "./dist/math/index.d.ts",
      "import": "./dist/math/index.js"
    },
    "./math.css": "./dist/styles/math.css",
    "./mermaid": {
      "types": "./dist/mermaid/index.d.ts",
      "import": "./dist/mermaid/index.js"
    },
    "./mermaid.css": "./dist/styles/mermaid.css"
  },
  "dependencies": {
    "@streamdown/cjk": "1.0.3",
    "@streamdown/code": "1.1.1",
    "@streamdown/math": "1.0.2",
    "@streamdown/mermaid": "1.0.2",
    "katex": "0.16.47",
    "lucide-react": "1.28.0",
    "mermaid": "11.16.1",
    "streamdown": "2.5.0"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@types/jsdom": "latest",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "jsdom": "27.3.0",
    "postcss": "8.5.25",
    "tsup": "^8.5.0",
    "typescript": "^5.9.0"
  },
  "scripts": {
    "verify:release": "pnpm audit:source && pnpm audit:css && pnpm audit:licenses && pnpm audit:package",
    "verify:consumer": "pnpm build && node scripts/verify-clean-consumer.mjs",
    "audit:css": "node scripts/audit-css-contract.mjs",
    "audit:licenses": "node scripts/audit-licenses.mjs",
    "audit:package": "node scripts/audit-package-files.mjs",
    "audit:source": "node scripts/audit-public-source.mjs",
    "build": "tsup && node scripts/copy-styles.mjs",
    "prepack": "pnpm build",
    "research:css": "node scripts/extract-observed-css.mjs",
    "test": "tsx --test tests/css/*.test.ts tests/renderer/*.test.tsx tests/security/*.test.ts",
    "typecheck": "tsc --noEmit"
  }
}
